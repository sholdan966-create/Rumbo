{
  "name": "rumbo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RUMBO - Gesti\u00f3n de transporte",
  "scripts": {
    "dev": "concurrently -n api,web -c teal,blue \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --tsconfig tsconfig.server.json src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build:static": "VITE_STATIC=1 vite build --outDir ../../dist-static --emptyOutDir",
    "demo": "cross-env DEMO_MODE=1 DATA_DIR=./data-demo concurrently -n api,web \"tsx watch --tsconfig tsconfig.server.json src/server/index.ts\" \"vite\"",
    "demo:start": "cross-env DEMO_MODE=1 DATA_DIR=./data-demo tsx --tsconfig tsconfig.server.json src/server/index.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "express": "^4.22.3",
    "lucide-react": "^1.76.0",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.20"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}